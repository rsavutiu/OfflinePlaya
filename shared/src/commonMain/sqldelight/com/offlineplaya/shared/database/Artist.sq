CREATE TABLE Artist (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    album_count INTEGER NOT NULL DEFAULT 0,
    track_count INTEGER NOT NULL DEFAULT 0,
    image_url TEXT
);

CREATE INDEX idx_artist_name ON Artist(name COLLATE NOCASE);

selectAll:
SELECT * FROM Artist ORDER BY name COLLATE NOCASE;

selectById:
SELECT * FROM Artist WHERE id = ?;

selectByName:
SELECT * FROM Artist WHERE name = ? COLLATE NOCASE;

insert:
INSERT OR IGNORE INTO Artist(name) VALUES (?);

updateCounts:
UPDATE Artist
SET album_count = (SELECT COUNT(DISTINCT album_id) FROM Track WHERE artist_id = Artist.id AND album_id IS NOT NULL),
    track_count = (SELECT COUNT(*) FROM Track WHERE artist_id = Artist.id)
WHERE id = ?;

updateImageUrl:
UPDATE Artist SET image_url = ? WHERE id = ?;

-- Majority casing of this artist's name among the raw track tags that
-- case-insensitively equal the row name. The artist row itself is frozen to
-- whichever casing was scanned FIRST (INSERT OR IGNORE + UNIQUE NOCASE), which
-- is arbitrary; the tags hold the real distribution. Binary ORDER BY on the
-- tie-break prefers the variant with uppercase letters ("Charli XCX" sorts
-- before "Charli Xcx"), which is the right call for acronym names.
selectCanonicalCasing:
SELECT artist_name FROM Track
WHERE artist_id = :id AND artist_name = :name COLLATE NOCASE
GROUP BY artist_name
ORDER BY COUNT(*) DESC, artist_name
LIMIT 1;

-- Recase only: the new name is NOCASE-equal to the old, so the UNIQUE
-- constraint can only "conflict" with the row being updated, which is legal.
rename:
UPDATE Artist SET name = :name WHERE id = :id;

lastInsertId:
SELECT last_insert_rowid();

-- Remove artists that nothing references — no track has their artist_id and
-- no album has them as album-artist. Cleans up the per-artist rows left
-- behind when a compilation's tracks regroup under "Various Artists".
deleteOrphans:
DELETE FROM Artist
WHERE id NOT IN (SELECT DISTINCT artist_id FROM Track WHERE artist_id IS NOT NULL)
  AND id NOT IN (SELECT DISTINCT artist_id FROM Album WHERE artist_id IS NOT NULL);

deleteAll:
DELETE FROM Artist;
