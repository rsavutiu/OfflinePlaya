    <string name="onboarding_welcome_title">Karibu na OfflinePlaya</string>
    <string name="onboarding_welcome_body">Mwakilishi wa muziki ambayo unapowekwa kwenye wiziji yako. Kila vitu vinaweza kutembelea vingi—haukupata akount, hakuwezesha streaming au hadia adabaka. Tafadhali tuma ujumla wa muziki langu.</string>
    <string name="onboarding_welcome_cta">Beggina</string>
    <string name="onboarding_permissions_title">Ongezeka kwa makumbusho mengi</string>
    <string name="onboarding_permissions_body">Yeye yametambua miziki wako na kutazama maombi ya playback. Unaweza kupata zingine katika uchungu wa system.</string>
    <string name="onboarding_permission_audio_title">Musik na michezo ya kikombina</string>
    <string name="onboarding_permission_audio_body">Kwa sababu OfflinePlaya unaweza kupata faili za audio katika urisasi wako — kabisa bila kusoma kitambulisho kutoka Downloads na Music.</string>
    <string name="onboarding_permission_audio_cta">Onyesha usalama wa musiki</string>
    <string name="onboarding_permission_notifications_title">Mstari ya matokeo</string>
    <string name="onboarding_permission_notifications_body">Kwa sababu uchaguzi wa mpya unaweza kupata katika shadani ya matokeo na kwenye screen cha lock wako kabisa bila kutambulishoa kitambulisho mbalimbali.</string>
    <string name="onboarding_permission_notifications_cta">Tuma mshwari</string>
    <string name="onboarding_permission_granted">Ulimuwa</string>
    <string name="onboarding_add_music_title">Ongeza ukumbuzi wako</string>
    <string name="onboarding_add_music_body">Chagua kifolder ya mpya files ili kupakua index. Music katika Downloads na folders yango inapakia automatiki baada ya music access umeulimuwa.</string>
