    <string name="permission_required_title">Music access needed</string>
    <string name="permission_required_body">OfflinePlaya is an offline player — it plays audio files stored on this device and can't do anything without permission to read them. Grant music access to continue.</string>
    <string name="permission_required_grant">Grant music access</string>
    <string name="permission_required_open_settings">App settings ஆகியைத் open</string>
    <string name="permission_required_denied_note">If nothing happens when you tap the button, the permission was blocked earlier — enable it from app settings instead.</string>
