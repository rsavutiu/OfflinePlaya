    <string name="onboarding_welcome_title">Welcome to OfflinePlaya</string>
    <string name="onboarding_welcome_body">A player for the music you already own. Everything stays on your device — no accounts, no streaming, no ads. Let's get your library set up.</string>
    <string name="onboarding_welcome_cta">Get started</string>
    <string name="onboarding_permissions_title">Grant a couple of permissions</string>
    <string name="onboarding_permissions_body">These let the app find your music and show playback controls. You can change them anytime in system settings.</string>
    <string name="onboarding_permission_audio_title">Music &amp; audio access</string>
    <string name="onboarding_permission_audio_body">So OfflinePlaya can find the audio files on your device — including anything in Downloads and Music.</string>
    <string name="onboarding_permission_audio_cta">Allow music access</string>
    <string name="onboarding_permission_notifications_title">Notifications</string>
    <string name="onboarding_permission_notifications_body">So playback controls appear in the notification shade and on your lock screen while music is playing.</string>
    <string name="onboarding_permission_notifications_cta">அறிவுரைகள் காண்பி</string>
