    <string name="onboarding_welcome_title">OfflinePlaya ಸ್ವಾಗತ!</string>
    <string name="onboarding_welcome_body">ನೀವು ಹೊರತುಪಡದ ಮೇಲೆಯೂ ಉള್ ಬಹुಮೈಸನ್‌ಗಳನ್ನು ಪ್ರದರ್ಶಿಸುವ ಒಂದು ವಚನಕ. Everything stays on your device — no accounts, no streaming, no ads. Let's get your library set up.</string>
    <string name="onboarding_welcome_cta">Get started</string>
    <string name="onboarding_permissions_title">Grant a couple of permissions</string>
