    <string name="permission_required_title">মাইসিক অপ্রকশ প্রয়োজন</string>
    <string name="permission_required_body">OfflinePlaya হল একটি আফ্টরওভে গণেষনা — যখন সমগ্‍তান ফাইলস কিছুই বারঘাত পদ্ধতি হবে। মাইসিকটি অপরওভে গণেষনা দিয়ে চালানো সম্ভব, একই বলে আপনার পড়তে মাইসিকটি অপরওভে গণেষনা দিয়ে চালানো সম্ভব।</string>
